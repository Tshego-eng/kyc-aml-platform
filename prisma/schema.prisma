generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ANALYST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  regulatoryReports RegulatoryReport[]
  auditLogs AuditLog[]
  kycReviews KYCReview[]
  assignedCases AMLCase[] @relation("AssignedCases")
investigationNotes InvestigationNote[] @relation("InvestigationNotes")
caseEvidenceUploads CaseEvidence[] @relation("CaseEvidenceUploads")
}

model Customer {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  idNumber      String    @unique
  country       String
  address       String?
  phone         String?
  email         String?
  occupation    String?
  annualIncome  Decimal?  @db.Decimal(15, 2)
  sourceOfFunds String?
  kycStatus     KYCStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  kycChecks       KYCCheck[]
  kycReviews      KYCReview[]
  riskAssessments RiskAssessment[]
  transactions    Transaction[]
  amlAlerts       AMLAlert[]
  amlCases        AMLCase[]
  regulatoryReports RegulatoryReport[]

  @@index([kycStatus])
  @@index([createdAt])
}

model KYCCheck {
  id         String       @id @default(cuid())
  customerId String
  checkType  KYCCheckType
  status     CheckStatus
  score      Int?
  notes      String?
  createdAt  DateTime     @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model RiskAssessment {
  id         String    @id @default(cuid())
  customerId String
  score      Int
  level      RiskLevel
  reasons    Json
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Transaction {
  id         String            @id @default(cuid())
  customerId String
  amount     Decimal           @db.Decimal(15, 2)
  currency   String            @default("ZAR")
  country    String
  type       TransactionType
  status     TransactionStatus @default(COMPLETED)
  timestamp  DateTime          @default(now())

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amlAlerts AMLAlert[]

  @@index([customerId])
  @@index([timestamp])
}

model AMLAlert {
  id            String       @id @default(cuid())
  customerId    String
  transactionId String?
  type          AMLAlertType
  severity      RiskLevel
  status        AlertStatus  @default(OPEN)
  description   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  case AMLCase?
  
  @@index([customerId])
  @@index([status])
  @@unique([transactionId, type])
}
model AMLCase {
  id              String       @id @default(cuid())
  alertId         String       @unique
  customerId      String
  assignedToId    String?
  status          CaseStatus   @default(OPEN)
  priority        RiskLevel    @default(MEDIUM)
  decision        CaseDecision?
  summary         String?
  resolution      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  closedAt        DateTime?
  regulatoryDecision RegulatoryDecision?
  regulatoryReason   String?

  alert           AMLAlert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo      User?        @relation("AssignedCases", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes           InvestigationNote[]
  evidence        CaseEvidence[]
  regulatoryReports RegulatoryReport[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
}

model RegulatoryReport {
  id                 String               @id @default(cuid())
  caseId             String
  customerId         String
  submittedById      String
  reportType         RegulatoryReportType
  status             RegulatoryReportStatus @default(DRAFT)
  reason             String
  referenceNumber    String?
  submittedAt       DateTime?
  acknowledgedAt    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  amlCase            AMLCase              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  submittedBy        User                 @relation(fields: [submittedById], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([customerId])
  @@index([submittedById])
  @@index([status])
  @@index([createdAt])
}

model InvestigationNote {
  id          String   @id @default(cuid())
  caseId      String
  authorId    String
  note        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case        AMLCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author      User     @relation("InvestigationNotes", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([authorId])
  @@index([createdAt])
}

model CaseEvidence {
  id          String   @id @default(cuid())
  caseId      String
  uploadedBy  String
  fileName    String
  fileType    String?
  description String?
  createdAt   DateTime @default(now())

  case        AMLCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploader    User     @relation("CaseEvidenceUploads", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([caseId])
  @@index([uploadedBy])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model KYCReview {
  id         String         @id @default(cuid())
  customerId String
  reviewerId String
  decision   ReviewDecision
  reason     String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reviewer User     @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([reviewerId])
  @@index([decision])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  COMPLIANCE_OFFICER
  ANALYST
  VIEWER
}

enum RegulatoryReportType {
  SUSPICIOUS_ACTIVITY
}

enum RegulatoryReportStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

enum KYCStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KYCCheckType {
  IDENTITY
  ADDRESS
  DATE_OF_BIRTH
  EMAIL
  PHONE
}

enum CheckStatus {
  PENDING
  PASSED
  FAILED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  PAYMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum RegulatoryDecision {
  FALSE_POSITIVE
  NO_FURTHER_ACTION
  INTERNAL_ESCALATION
  REGULATORY_REPORT
}

enum AMLAlertType {
  LARGE_TRANSACTION
  STRUCTURING
  RAPID_MOVEMENT
  HIGH_RISK_COUNTRY
  UNUSUAL_ACTIVITY
  PEP_MATCH
  INCOME_MISMATCH
}

enum AlertStatus {
  OPEN
  INVESTIGATING
  ESCALATED
  RESOLVED
  FALSE_POSITIVE
}


enum ReviewDecision {
  APPROVE
  REJECT
  REQUEST_REVIEW
}

enum CaseStatus {
  OPEN
  INVESTIGATING
  ESCALATED
  RESOLVED
  CLOSED
  FALSE_POSITIVE
}
enum CaseDecision {
  NO_ACTION
  SUSPICIOUS_ACTIVITY
  FALSE_POSITIVE
  ESCALATE
}