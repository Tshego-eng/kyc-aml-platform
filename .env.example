# --- Required ---

DATABASE_URL="your_postgresql_connection_string"

JWT_SECRET="your_jwt_secret"

# --- Server ---

PORT=5000

# "development" or "production". In production, CORS_ORIGIN below is
# required, and unhandled-error responses omit internal details.
NODE_ENV="development"

# The frontend origin allowed to call this API, e.g.
# CORS_ORIGIN="https://your-frontend.pages.dev"
# Required when NODE_ENV=production. In development, if unset, falls
# back to http://localhost:5173.
CORS_ORIGIN=""

# --- Optional ---

# JWT token lifetime (jsonwebtoken "expiresIn" format, e.g. "1h", "30m",
# "7d"). Defaults to "1h" if unset.
JWT_EXPIRES_IN="1h"

# --- AML detection thresholds (all optional — defaults shown) ---
# See server/src/services/aml.service.ts for how each is used.

# Flags a transaction as large above this amount. Default: 100000
AML_LARGE_TRANSACTION_THRESHOLD=100000

# Comma-separated country names treated as high-risk. The built-in
# default ("CountryA,CountryB,CountryC") is a placeholder and will
# never match real data — set this for the high-risk-country rule to
# do anything meaningful.
AML_HIGH_RISK_COUNTRIES="CountryA,CountryB,CountryC"

# Rolling window (minutes) used for rapid-movement detection. Default: 30
AML_RAPID_MOVEMENT_WINDOW_MINUTES=30

# Cumulative amount within the window that flags rapid movement.
# Default: 50000
AML_RAPID_MOVEMENT_THRESHOLD=50000

# Minimum number of transactions within the window required before
# rapid-movement detection applies. Default: 2
AML_RAPID_MOVEMENT_MIN_TRANSACTIONS=2

# Fractional threshold (e.g. 0.25 = 25%) for flagging a transaction as
# mismatched against a customer's stated income. Default: 0.25
AML_INCOME_MISMATCH_PERCENTAGE=0.25

# --- Seeding (server/seed.ts) ---
# Only used if you intentionally run `npx tsx seed.ts`. Never set these
# in a deployed environment's persistent config — set them only for the
# single run, then remove them. The script will not run without both,
# and there is no default admin account or password.

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
